# --- IDE / OS ---
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
~$*

# --- OpenTofu / Terraform ---
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
*.tfplan
*.tfvars
!*.tfvars.example
crash.log
crash.*.log

# --- Ansible ---
*.retry
.vault_password
*vault-pass*
inventories/**/hosts.yml
!inventories/**/hosts.example.yml

# --- Secrets / keys / credentials ---
.env
!.env.example
*.pem
*.key
*_rsa
*_ed25519
id_rsa*
id_ed25519*
*.agekey
age.key
*.asc
kubeconfig*
!kubeconfig*.example
.kube/
*.p12
*.pfx
*credentials*
!*credentials*.example

# --- Local overrides (real topology, never public) ---
local/
*.local.yaml
*.local.yml

# --- Backups / archives ---
*.bak
*.backup
*.tar.gz
*.zip

# --- Node (Claude Code hooks) ---
node_modules/

# --- Misc ---
*.log
.cache/
