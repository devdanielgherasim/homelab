# --- IDE / OS ---
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
~$*

# --- OpenTofu / Terraform ---
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
*.tfplan
*.tfvars
!*.tfvars.example
crash.log
crash.*.log

# --- Ansible ---
# NOTE: patterns below use a leading **/ so they match at any nesting
# depth (e.g. ansible/inventories/production/hosts.yml) — a pattern
# starting with a bare directory name like "inventories/..." (no leading
# **/) is anchored to the repo root in gitignore semantics and would
# silently NOT match this nested path. Verified with `git add -A -n`
# before every commit that touches ansible/inventories/, not assumed.
*.retry
.vault_password
*vault-pass*
**/inventories/**/hosts.yml
!**/inventories/**/hosts.example.yml
**/inventories/**/group_vars/*.yml
!**/inventories/**/group_vars/*.yml.example

# --- Secrets / keys / credentials ---
.env
!.env.example
*.pem
*.key
*_rsa
*_ed25519
id_rsa*
id_ed25519*
*.agekey
age.key
*.asc
kubeconfig*
!kubeconfig*.example
.kube/
*.p12
*.pfx
*credentials*
!*credentials*.example

# --- Local overrides (real topology, never public) ---
local/
*.local.yaml
*.local.yml

# --- Backups / archives ---
*.bak
*.backup
*.tar.gz
*.zip

# --- Node (Claude Code hooks) ---
node_modules/

# --- Misc ---
*.log
.cache/
